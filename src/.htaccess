# Limit HTTP request body to 10MB
LimitRequestBody 10485760

# PHP upload configuration
<IfModule mod_php.c>
    php_value upload_max_filesize 5M
    php_value post_max_size 10M
</IfModule>
<IfModule mod_php7.c>
    php_value upload_max_filesize 5M
    php_value post_max_size 10M
</IfModule>
<IfModule mod_php8.c>
    php_value upload_max_filesize 5M
    php_value post_max_size 10M
</IfModule>

# Do not expose build metadata or dependency manifests over HTTP.
# version.json is still read server-side by getAppVersionInfo().
<FilesMatch "^(version\.json|composer\.(json|lock))$">
    Require all denied
</FilesMatch>
